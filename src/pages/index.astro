---
import Background from '../components/Background.astro';
import Header from '../components/Header.astro';
import SocialBar from '../components/SocialBar.astro';
import LinkCard from '../components/LinkCard.astro';
import QRCodeModal from '../components/QRCodeModal.astro';
import Toast from '../components/Toast.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import { getProfileData } from '../lib/cms';
import '../styles/global.css';

// Fetch profile data at build time (with fallback to local profile.json)
const profile = await getProfileData();

// Group links by category for structured presentation
const groupedLinks = (profile.links || []).reduce((acc, link) => {
  const cat = link.category || 'Liên Kết';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(link);
  return acc;
}, {} as Record<string, typeof profile.links>);

const categories = Object.keys(groupedLinks);
const sheetId = import.meta.env.PUBLIC_GOOGLE_SHEET_ID || '';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans with full Vietnamese & Latin character set -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" 
      rel="stylesheet" 
    />

    <!-- SEO & Social OpenGraph Meta Tags -->
    <title>{profile.name} {profile.handle ? `| ${profile.handle}` : ''}</title>
    {profile.bio && <meta name="description" content={profile.bio.split('|')[0].trim()} />}
    <meta property="og:title" content={profile.name} />
    {profile.bio && <meta property="og:description" content={profile.bio.split('|')[0].trim()} />}
    <meta property="og:type" content="profile" />
    {profile.avatar && <meta property="og:image" content={profile.avatar} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={profile.name} />
    {profile.bio && <meta name="twitter:description" content={profile.bio.split('|')[0].trim()} />}
    <meta name="theme-color" content="#fafafa" />
  </head>
  <body data-sheet-id={sheetId} class="bg-[#fafafa] text-slate-900 flex flex-col items-center min-h-screen selection:bg-blue-100 selection:text-blue-900">
    <!-- Ambient modern pastel mesh background -->
    <Background />

    <!-- Top Navigation with Language Toggle -->
    <LanguageToggle />

    <!-- Responsive Container (Mobile-first, max-w-lg) -->
    <main class="w-full max-w-lg mx-auto px-4 sm:px-6 flex flex-col items-center flex-grow">
      <!-- Profile Header -->
      <Header profile={profile} />

      <!-- Social Networks Bar (only renders if valid links exist) -->
      <SocialBar socials={profile.socials} />

      <!-- Links Container -->
      <div id="links-container" class="w-full space-y-5 mb-12">
        {profile.links && profile.links.length > 0 ? (
          categories.map((category) => (
            <section class="w-full space-y-2.5">
              {categories.length > 1 && category !== 'Liên Kết' && (
                <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 pl-1 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                  <span data-bilingual={category}>{category.split('|')[0].trim()}</span>
                </h2>
              )}
              <div class="space-y-2.5">
                {groupedLinks[category].map((link) => (
                  <LinkCard link={link} />
                ))}
              </div>
            </section>
          ))
        ) : (
          <div class="w-full p-8 rounded-2xl bg-white/90 backdrop-blur-md border border-slate-200/80 text-center shadow-sm">
            <p data-i18n="empty" class="text-sm font-medium text-slate-700">Chưa có liên kết nào được kích hoạt.</p>
            <p data-i18n="emptyDesc" class="text-xs text-slate-400 mt-1">Thêm hàng mới vào Google Sheet để hiển thị liên kết tại đây ✨</p>
          </div>
        )}
      </div>

      <!-- Clean Minimal Footer -->
      <footer class="mt-auto py-6 text-center text-xs text-slate-400">
        <p>© {new Date().getFullYear()} {profile.name}</p>
      </footer>
    </main>

    <!-- Modals & Feedback Elements -->
    <QRCodeModal name={profile.name} avatar={profile.avatar || '/avatar.svg'} />
    <Toast />

    <!-- Live Client-side sync with Google Sheets (1-minute throttle cooldown) -->
    {sheetId && (
      <script>
        import { initLiveSync } from '../lib/liveSync';
        const sheetId = document.body.dataset.sheetId;
        if (sheetId) initLiveSync(sheetId);
      </script>
    )}
  </body>
</html>
