---
import type { LinkItem } from '../lib/types';
import { iconRegistry } from '../lib/icons';

interface Props {
  link: LinkItem;
}

const { link } = Astro.props;

const iconKey = (link.icon || 'link').toLowerCase();
const iconDef = iconRegistry[iconKey] || iconRegistry.link;
const isPhone = iconKey === 'phone';
const isEmail = iconKey === 'email';
---

<a
  href={link.url}
  target={isPhone || isEmail ? undefined : '_blank'}
  rel={isPhone || isEmail ? undefined : 'noopener noreferrer'}
  class={`group relative flex items-center justify-between p-3.5 sm:p-4 rounded-2xl w-full transition-all duration-200 active:scale-[0.99] ${
    link.highlight
      ? 'highlight-border-light'
      : 'link-card'
  }`}
>
  <div class="flex items-center gap-3.5 min-w-0 pr-3">
    <!-- Icon Container with Brand Colors -->
    <div
      class={`flex-shrink-0 w-11 h-11 rounded-xl flex items-center justify-center transition-all duration-200 group-hover:scale-105 border ${
        link.highlight
          ? 'bg-blue-50 text-blue-600 border-blue-200/80'
          : `${iconDef.bgAccent || 'bg-slate-100 border-slate-200/60'} ${iconDef.brandColor || 'text-slate-700'}`
      }`}
    >
      <svg
        class="w-5 h-5 transition-transform duration-200 group-hover:scale-110"
        viewBox="0 0 24 24"
        fill={iconDef.isFillOnly ? 'currentColor' : 'none'}
        stroke={iconDef.isFillOnly ? 'none' : 'currentColor'}
        set:html={iconDef.svg}
      />
    </div>

    <!-- Text info -->
    <div class="min-w-0 text-left">
      <div class="flex items-center gap-2">
        <h3 class="text-sm sm:text-base font-semibold text-slate-900 truncate group-hover:text-blue-600 transition-colors">
          {link.title}
        </h3>
        {link.highlight && (
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-sm">
            Hot
          </span>
        )}
      </div>

      {link.subtitle && (
        <p class="text-xs text-slate-500 truncate mt-0.5">
          {link.subtitle}
        </p>
      )}
    </div>
  </div>

  <!-- Arrow Right / Action Indicator -->
  <div class="flex-shrink-0 text-slate-400 group-hover:text-blue-600 transition-all duration-200 transform group-hover:translate-x-1">
    {isPhone ? (
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200">
        Gọi ngay
      </span>
    ) : isEmail ? (
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-600 border border-amber-200">
        Gửi thư
      </span>
    ) : (
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    )}
  </div>
</a>
