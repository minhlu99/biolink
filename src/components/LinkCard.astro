---
import type { LinkItem } from '../lib/types';
import { iconRegistry } from '../lib/icons';

interface Props {
  link: LinkItem;
}

const { link } = Astro.props;

const iconKey = (link.icon || 'link').toLowerCase();
const iconDef = iconRegistry[iconKey] || iconRegistry.link;
const isPhone = iconKey === 'phone';
const isEmail = iconKey === 'email';
---

<a
  href={link.url}
  target={isPhone || isEmail ? undefined : '_blank'}
  rel={isPhone || isEmail ? undefined : 'noopener noreferrer'}
  class={`group relative flex items-center justify-between p-4 sm:p-4.5 rounded-2xl w-full transition-all duration-200 active:scale-[0.99] ${
    link.highlight
      ? 'highlight-border-light'
      : 'link-card'
  }`}
>
  <div class="flex items-center gap-3.5 min-w-0 pr-2">
    <!-- Full Icon (Borderless, prominent size ~32px) -->
    <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9">
      <svg
        class={`w-7 h-7 sm:w-8 sm:h-8 transition-transform duration-200 group-hover:scale-110 drop-shadow-sm ${iconDef.brandColor || 'text-slate-800'}`}
        viewBox="0 0 24 24"
        fill={iconDef.isFillOnly ? 'currentColor' : 'none'}
        stroke={iconDef.isFillOnly ? 'none' : 'currentColor'}
        set:html={iconDef.svg}
      />
    </div>

    <!-- Text info -->
    <div class="min-w-0 text-left">
      <div class="flex items-center gap-2 flex-wrap">
        <h3 
          data-bilingual={link.title}
          class="text-sm sm:text-base font-semibold text-slate-900 truncate group-hover:text-blue-600 transition-colors"
        >
          {link.title.split('|')[0].trim()}
        </h3>

        <!-- Pinned Badge if enabled -->
        {link.pinned && (
          <span 
            class="inline-flex items-center gap-1 text-[10px] font-semibold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full border border-blue-200/80" 
            title="Được ghim lên đầu"
          >
            <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
              <path d="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"/>
            </svg>
            <span data-i18n="pinned">Ghim</span>
          </span>
        )}

        <!-- Highlight Badge if enabled -->
        {link.highlight && (
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 text-white shadow-sm">
            <span data-i18n="hot">Hot</span>
          </span>
        )}
      </div>

      {link.subtitle && (
        <p 
          data-bilingual={link.subtitle}
          class="text-xs text-slate-500 truncate mt-0.5"
        >
          {link.subtitle.split('|')[0].trim()}
        </p>
      )}
    </div>
  </div>

  <!-- Arrow Right / Action Indicator -->
  <div class="flex-shrink-0 text-slate-400 group-hover:text-blue-600 transition-all duration-200 transform group-hover:translate-x-1 pl-2">
    {isPhone ? (
      <span 
        data-i18n="callNow"
        class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200/80 shadow-sm"
      >
        Gọi ngay
      </span>
    ) : isEmail ? (
      <span 
        data-i18n="sendMail"
        class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200/80 shadow-sm"
      >
        Gửi thư
      </span>
    ) : (
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    )}
  </div>
</a>
