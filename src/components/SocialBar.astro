---

{socials && socials.length > 0 && (
  <nav aria-label="Social profiles" class="flex flex-wrap items-center justify-center gap-2.5 px-4 mb-6">
    {socials.map((item) => {
      const platformKey = item.platform ? item.platform.toLowerCase() : 'website';
      const iconDef = brandIcons[platformKey] || brandIcons.website;
      return (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.label || item.platform}
          title={item.label || item.platform}
          class={`group relative p-2.5 rounded-xl bg-white/[0.04] border border-white/10 text-slate-300 transition-all duration-300 shadow-sm active:scale-90 ${iconDef.hoverColor}`}
        >
          <svg class="w-5 h-5 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24">
            <path d={iconDef.path} />
          </svg>
        </a>
      );
    })}
  </nav>
)}
