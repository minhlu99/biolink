---
import type { SocialItem } from '../lib/types';
import { processUrlAndIcon, iconRegistry } from '../lib/icons';

interface Props {
  socials?: SocialItem[];
}

const { socials = [] } = Astro.props;

// Process each social item: auto-detect platform from URL if needed
const processedSocials = socials
  .map((item) => {
    if (!item || !item.url) return null;
    const { url, icon } = processUrlAndIcon(item.url, item.platform);
    return {
      ...item,
      url,
      platform: icon,
    };
  })
  .filter((item): item is SocialItem => {
    if (!item || !item.url) return false;
    const u = item.url.trim().toLowerCase();
    if (u === '' || u === '#' || u === 'https://' || u === 'http://') return false;
    const bareDomains = [
      'https://facebook.com',
      'https://facebook.com/',
      'https://instagram.com',
      'https://instagram.com/',
      'https://tiktok.com',
      'https://tiktok.com/',
      'https://youtube.com',
      'https://youtube.com/',
      'https://t.me',
      'https://t.me/',
      'https://x.com',
      'https://x.com/',
      'https://threads.net',
      'https://threads.net/',
      'https://threads.com',
      'https://threads.com/',
      'mailto:example@gmail.com',
      'mailto:',
      'tel:',
    ];
    return !bareDomains.includes(u);
  });
---

{processedSocials.length > 0 && (
  <nav aria-label="Social profiles" class="flex flex-wrap items-center justify-center gap-2.5 px-4 mb-6">
    {processedSocials.map((item) => {
      const platformKey = item.platform.toLowerCase();
      const iconDef = iconRegistry[platformKey] || iconRegistry.link;
      const isCall = platformKey === 'phone';
      const isMail = platformKey === 'email';

      return (
        <a
          href={item.url}
          target={isCall || isMail ? undefined : '_blank'}
          rel={isCall || isMail ? undefined : 'noopener noreferrer'}
          aria-label={item.label || iconDef.name}
          title={item.label || iconDef.name}
          class={`group relative p-2.5 rounded-full bg-white/80 backdrop-blur-md border border-white/90 text-slate-600 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md hover:bg-white active:scale-90 ${iconDef.brandColor || 'hover:text-blue-600'}`}
        >
          <svg
            class="w-5 h-5 fill-current transition-transform duration-200 group-hover:scale-110"
            viewBox="0 0 24 24"
            fill={iconDef.isFillOnly ? 'currentColor' : 'none'}
            stroke={iconDef.isFillOnly ? 'none' : 'currentColor'}
            set:html={iconDef.svg}
          />
        </a>
      );
    })}
  </nav>
)}
