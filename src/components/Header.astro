---
import type { Profile } from '../lib/types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<header class="flex flex-col items-center text-center pt-8 pb-6 px-4">
  <!-- Avatar Container with Gradient Glow Ring -->
  <div class="relative group cursor-pointer mb-4">
    <!-- Breathing Ambient Aura -->
    <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-400 via-indigo-500 to-purple-500 rounded-full blur-md opacity-70 group-hover:opacity-100 group-hover:scale-105 transition duration-500 animate-pulse-subtle"></div>
    
    <!-- Image Wrapper -->
    <div class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-2 border-white/20 bg-dark-900 p-0.5 shadow-xl">
      <img
        src={profile.avatar || '/avatar.svg'}
        alt={profile.name}
        class="w-full h-full object-cover rounded-full transform group-hover:scale-105 transition duration-500"
        loading="eager"
      />
    </div>

    <!-- Verified Badge if enabled -->
    {profile.verified && (
      <div 
        class="absolute bottom-1 right-1 bg-cyan-500 text-dark-950 p-1 rounded-full shadow-lg border-2 border-dark-950 flex items-center justify-center"
        title="Đã xác minh"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
      </div>
    )}
  </div>

  <!-- Live Status Badge (if available) -->
  {profile.status && (
    <div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full text-xs font-medium bg-white/[0.04] border border-white/10 text-slate-300 shadow-sm backdrop-blur-md">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>{profile.status.text}</span>
    </div>
  )}

  <!-- Name & Handle -->
  <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-1 flex items-center gap-2 justify-center">
    <span>{profile.name}</span>
  </h1>
  {profile.handle && <p class="text-sm font-medium text-cyan-400 mb-3">{profile.handle}</p>}

  <!-- Bio -->
  {profile.bio && (
    <p class="text-sm sm:text-base text-slate-300 max-w-md leading-relaxed mb-4">
      {profile.bio}
    </p>
  )}

  <!-- Location (if present) -->
  {profile.location && (
    <div class="flex items-center gap-1.5 text-xs text-slate-400 mb-5">
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span>{profile.location}</span>
    </div>
  )}

  <!-- Action Buttons: Share & QR -->
  <div class="flex items-center gap-2.5">
    <!-- Share Button -->
    <button
      id="btn-share-bio"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-medium bg-white/[0.06] hover:bg-white/[0.12] text-slate-200 border border-white/10 hover:border-white/20 transition-all duration-200 shadow-sm active:scale-95 cursor-pointer"
      title="Chia sẻ trang này"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
      </svg>
      <span>Chia sẻ</span>
    </button>

    <!-- QR Code Button -->
    <button
      id="btn-open-qr"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-medium bg-white/[0.06] hover:bg-white/[0.12] text-slate-200 border border-white/10 hover:border-white/20 transition-all duration-200 shadow-sm active:scale-95 cursor-pointer"
      title="Mở mã QR cá nhân"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
      </svg>
      <span>Mã QR</span>
    </button>
  </div>
</header>
