---
import type { Profile } from '../lib/types';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
---

<header class="flex flex-col items-center text-center pt-8 pb-5 px-4 w-full">
  <!-- Avatar Container (Size: 112px - 144px) -->
  <div class="relative group cursor-pointer mb-4">
    <!-- Dynamic Breathing Iridescent Halo Aura -->
    <div 
      class="absolute -inset-1 sm:-inset-1.5 rounded-full bg-gradient-to-tr from-indigo-500 via-pink-400 to-amber-300 opacity-70 blur-md group-hover:opacity-100 group-hover:scale-105 group-hover:blur-lg transition-all duration-500 animate-halo-pulse pointer-events-none"
      aria-hidden="true"
    ></div>

    <!-- Soft specular frame -->
    <div class="relative w-28 h-28 sm:w-36 sm:h-36 rounded-full overflow-hidden border-4 border-white/95 bg-white shadow-xl shadow-slate-200/60 p-0.5">
      <img
        src={profile.avatar || '/avatar.webp'}
        srcset={(!profile.avatar || profile.avatar === '/avatar.webp') ? '/avatar-144.webp 144w, /avatar.webp 288w' : undefined}
        sizes="(max-width: 640px) 112px, 144px"
        alt={profile.name}
        width="144"
        height="144"
        decoding="async"
        fetchpriority="high"
        class="w-full h-full object-cover rounded-full transform group-hover:scale-105 transition duration-300"
        loading="eager"
      />
    </div>

  </div>

  <!-- Live Status Badge (if available) -->
  <div id="header-status-container" class={!profile.status ? 'hidden' : ''}>
    {profile.status && (
      <div 
        id="header-status-badge" 
        class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full text-xs font-medium bg-white/85 backdrop-blur-md border border-slate-200/80 text-slate-700 shadow-sm transition-all hover:bg-white"
      >
        <span class="flex items-end gap-0.5 h-3" aria-hidden="true">
          <span class="w-0.5 bg-emerald-500 rounded-full vibe-bar-1"></span>
          <span class="w-0.5 bg-emerald-500 rounded-full vibe-bar-2"></span>
          <span class="w-0.5 bg-emerald-500 rounded-full vibe-bar-3"></span>
        </span>
        <span id="header-status-text" data-bilingual={profile.status.text}>{profile.status.text.split('|')[0].trim()}</span>
      </div>
    )}
  </div>

  <!-- Name & Verified Rosette Seal (Authentic X Style - Optically Centered) -->
  <div class="inline-flex items-center justify-center gap-1.5 mb-1 max-w-full">
    {profile.verified && (
      <span class="w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0 invisible pointer-events-none select-none" aria-hidden="true" />
    )}
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 drop-shadow-sm truncate">
      {profile.name}
    </h1>
    {profile.verified && (
      <span 
        class="inline-flex items-center justify-center cursor-pointer flex-shrink-0 transition-transform duration-200 hover:scale-110 active:scale-95"
        title="Tài khoản chính chủ đã xác minh"
        aria-label="Tài khoản chính chủ đã xác minh"
      >
        <svg 
          class="w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0" 
          viewBox="0 0 22 22" 
          fill="none"
          aria-hidden="true"
        >
          <!-- Authentic X (Twitter) verified rosette -->
          <path 
            fill="#1d9bf0" 
            d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.687.878.633.132 1.29.084 1.897-.136.274.586.705 1.084 1.246 1.439.54.354 1.17.551 1.816.569.647-.016 1.276-.213 1.817-.567s.972-.854 1.245-1.44c.604.239 1.266.296 1.903.164.636-.132 1.22-.447 1.68-.907.46-.46.776-1.044.908-1.681s.075-1.299-.165-1.903c.586-.274 1.084-.705 1.439-1.246.354-.54.551-1.17.569-1.816z"
          />
          <!-- Authentic X (Twitter) white checkmark -->
          <path 
            fill="#ffffff" 
            d="M9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z"
          />
        </svg>
      </span>
    )}
  </div>
  <p 
    id="header-handle" 
    class={`text-sm font-medium text-slate-500 mb-3 ${!profile.handle ? 'hidden' : ''}`}
  >
    {profile.handle || ''}
  </p>

  <!-- Bio -->
  {profile.bio && (
    <p 
      data-bilingual={profile.bio}
      class="text-sm sm:text-base text-slate-600 max-w-md leading-relaxed mb-4"
    >
      {profile.bio.split('|')[0].trim()}
    </p>
  )}

  <!-- Location (if present) -->
  {profile.location && (
    <div class="flex items-center gap-1.5 text-xs text-slate-500 mb-4">
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span data-bilingual={profile.location}>{profile.location.split('|')[0].trim()}</span>
    </div>
  )}

  <!-- Action Buttons: Share & QR -->
  <div class="flex items-center gap-2.5">
    <button
      id="btn-share-bio"
      aria-label="Chia sẻ trang này"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white hover:bg-slate-50 text-slate-700 border border-slate-200/80 hover:border-slate-300 transition-all shadow-sm active:scale-95 cursor-pointer"
      title="Chia sẻ trang này"
    >
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
      </svg>
      <span data-i18n="share">Chia sẻ</span>
    </button>

    <button
      id="btn-open-qr"
      aria-label="Mở mã QR cá nhân"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white hover:bg-slate-50 text-slate-700 border border-slate-200/80 hover:border-slate-300 transition-all shadow-sm active:scale-95 cursor-pointer"
      title="Mở mã QR cá nhân"
    >
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
      </svg>
      <span data-i18n="qr">Mã QR</span>
    </button>
  </div>
</header>
