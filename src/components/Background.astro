---
// Clean, light aesthetic ambient background
---

<div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden bg-slate-50">
  <!-- Subtle warm ambient blur at top -->
  <div 
    class="absolute -top-[10%] left-1/2 -translate-x-1/2 w-[600px] h-[500px] bg-gradient-to-b from-blue-100/60 via-purple-50/40 to-transparent rounded-full blur-[100px]"
  ></div>

  <!-- Ultra soft pastel accent at side -->
  <div 
    class="absolute top-[40%] -left-[10%] w-[450px] h-[450px] bg-sky-100/40 rounded-full blur-[120px]"
  ></div>
  <div 
    class="absolute bottom-[10%] -right-[10%] w-[450px] h-[450px] bg-indigo-50/50 rounded-full blur-[120px]"
  ></div>
</div>
