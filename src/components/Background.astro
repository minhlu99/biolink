---
// Modern light gradient ambient background (Bento / Apple / Linktree Pro aesthetic)
---

<div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden bg-[#fafafa]">
  <!-- Fluid ambient aura mesh (GPU-accelerated, floating pastel lights) -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Orb 1: Soft Indigo / Periwinkle (Top Left) -->
    <div class="orb orb-1 absolute -top-[15%] -left-[10%] w-[70vw] h-[70vw] max-w-[560px] max-h-[560px] rounded-full blur-[75px] sm:blur-[110px] opacity-75 bg-gradient-to-br from-indigo-200/80 via-blue-100/50 to-transparent"></div>

    <!-- Orb 2: Soft Lilac / Lavender (Top Right) -->
    <div class="orb orb-2 absolute -top-[10%] -right-[10%] w-[65vw] h-[65vw] max-w-[520px] max-h-[520px] rounded-full blur-[80px] sm:blur-[115px] opacity-70 bg-gradient-to-bl from-purple-200/75 via-fuchsia-100/40 to-transparent"></div>

    <!-- Orb 3: Warm Peach / Champagne Sunlight (Center Glow) -->
    <div class="orb orb-3 absolute top-[30%] left-[20%] w-[60vw] h-[60vw] max-w-[480px] max-h-[480px] rounded-full blur-[85px] sm:blur-[120px] opacity-50 bg-gradient-to-tr from-amber-100/70 via-orange-50/35 to-transparent"></div>

    <!-- Orb 4: Soft Sky / Cyan Mist (Bottom Left) -->
    <div class="orb orb-4 absolute -bottom-[10%] -left-[10%] w-[70vw] h-[70vw] max-w-[540px] max-h-[540px] rounded-full blur-[75px] sm:blur-[110px] opacity-65 bg-gradient-to-tr from-sky-200/70 via-blue-100/35 to-transparent"></div>

    <!-- Orb 5: Soft Rose / Blossom (Bottom Right) -->
    <div class="orb orb-5 absolute -bottom-[10%] -right-[10%] w-[65vw] h-[65vw] max-w-[500px] max-h-[500px] rounded-full blur-[80px] sm:blur-[115px] opacity-60 bg-gradient-to-tl from-rose-100/70 via-violet-100/35 to-transparent"></div>
  </div>

  <!-- Ultra-subtle micro-dot noise pattern for paper/canvas texture depth -->
  <div 
    class="absolute inset-0 opacity-[0.025]"
    style="background-image: radial-gradient(#000000 1px, transparent 1px); background-size: 20px 20px;"
  ></div>
</div>

<style>
  .orb {
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }

  .orb-1 {
    animation: floatOrb1 20s ease-in-out infinite alternate;
  }

  .orb-2 {
    animation: floatOrb2 24s ease-in-out infinite alternate;
  }

  .orb-3 {
    animation: floatOrb3 28s ease-in-out infinite alternate;
  }

  .orb-4 {
    animation: floatOrb4 22s ease-in-out infinite alternate;
  }

  .orb-5 {
    animation: floatOrb5 26s ease-in-out infinite alternate;
  }

  @keyframes floatOrb1 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1);
    }
    50% {
      transform: translate3d(50px, 40px, 0) scale(1.08);
    }
    100% {
      transform: translate3d(-30px, 70px, 0) scale(0.95);
    }
  }

  @keyframes floatOrb2 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1);
    }
    50% {
      transform: translate3d(-60px, 45px, 0) scale(1.06);
    }
    100% {
      transform: translate3d(30px, -35px, 0) scale(0.94);
    }
  }

  @keyframes floatOrb3 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1);
    }
    50% {
      transform: translate3d(-40px, -50px, 0) scale(1.1);
    }
    100% {
      transform: translate3d(45px, 35px, 0) scale(0.92);
    }
  }

  @keyframes floatOrb4 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1);
    }
    50% {
      transform: translate3d(60px, -40px, 0) scale(1.05);
    }
    100% {
      transform: translate3d(-30px, -55px, 0) scale(0.95);
    }
  }

  @keyframes floatOrb5 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1);
    }
    50% {
      transform: translate3d(-45px, -45px, 0) scale(1.07);
    }
    100% {
      transform: translate3d(35px, 40px, 0) scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb {
      animation: none !important;
    }
  }
</style>
