---
// Living ambient pastel aura background (Dynamic Apple / Stripe / Bento aesthetic)
---

<div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden ambient-mesh">
  <!-- Dynamic floating aura blooms (GPU-accelerated, high-contrast pastel lights) -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Bloom 1: Indigo & Electric Blue (Top Left) -->
    <div class="orb orb-1 absolute -top-[10%] -left-[10%] w-[85vw] h-[85vw] max-w-[540px] max-h-[540px] rounded-full blur-[65px] sm:blur-[85px] opacity-75 bg-gradient-to-tr from-indigo-300 via-blue-200 to-purple-200"></div>

    <!-- Bloom 2: Rose Pink & Soft Lilac (Top Right) -->
    <div class="orb orb-2 absolute -top-[5%] -right-[10%] w-[80vw] h-[80vw] max-w-[500px] max-h-[500px] rounded-full blur-[65px] sm:blur-[85px] opacity-70 bg-gradient-to-bl from-pink-300 via-rose-200 to-purple-200"></div>

    <!-- Bloom 3: Cyan Sky & Fresh Mint (Bottom Left) -->
    <div class="orb orb-3 absolute -bottom-[10%] -left-[10%] w-[85vw] h-[85vw] max-w-[520px] max-h-[520px] rounded-full blur-[65px] sm:blur-[85px] opacity-65 bg-gradient-to-tr from-sky-200 via-cyan-200 to-teal-100"></div>

    <!-- Bloom 4: Golden Amber & Warm Peach (Bottom Right) -->
    <div class="orb orb-4 absolute -bottom-[10%] -right-[10%] w-[80vw] h-[80vw] max-w-[480px] max-h-[480px] rounded-full blur-[65px] sm:blur-[85px] opacity-65 bg-gradient-to-tl from-amber-200 via-orange-100 to-pink-200"></div>

    <!-- Celestial micro-sparkles for depth & magic -->
    <div class="sparkle top-[14%] left-[12%] animate-sparkle-1"></div>
    <div class="sparkle top-[28%] right-[14%] animate-sparkle-2"></div>
    <div class="sparkle top-[65%] left-[8%] animate-sparkle-3"></div>
    <div class="sparkle top-[82%] right-[12%] animate-sparkle-1"></div>
  </div>

  <!-- Ultra-subtle micro-dot noise pattern for paper/canvas texture depth -->
  <div 
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: radial-gradient(#000000 1px, transparent 1px); background-size: 20px 20px;"
  ></div>
</div>

<style>
  .ambient-mesh {
    contain: strict;
    content-visibility: auto;
    background: linear-gradient(135deg, #fafafa 0%, #f1f5f9 20%, #e0e7ff 45%, #fae8ff 70%, #fef3c7 90%, #fafafa 100%);
    background-size: 300% 300%;
    animation: meshShift 14s ease-in-out infinite alternate;
  }

  @keyframes meshShift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 50% 100%;
    }
  }

  .orb {
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }

  .orb-1 {
    animation: floatOrb1 9s ease-in-out infinite alternate;
  }

  .orb-2 {
    animation: floatOrb2 11s ease-in-out infinite alternate;
  }

  .orb-3 {
    animation: floatOrb3 10s ease-in-out infinite alternate;
  }

  .orb-4 {
    animation: floatOrb4 12s ease-in-out infinite alternate;
  }

  @keyframes floatOrb1 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1) rotate(0deg);
    }
    50% {
      transform: translate3d(120px, 80px, 0) scale(1.18) rotate(45deg);
    }
    100% {
      transform: translate3d(-70px, 130px, 0) scale(0.92) rotate(90deg);
    }
  }

  @keyframes floatOrb2 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1) rotate(0deg);
    }
    50% {
      transform: translate3d(-130px, 90px, 0) scale(1.15) rotate(-45deg);
    }
    100% {
      transform: translate3d(60px, -70px, 0) scale(0.88) rotate(-90deg);
    }
  }

  @keyframes floatOrb3 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1);
    }
    50% {
      transform: translate3d(110px, -90px, 0) scale(1.16);
    }
    100% {
      transform: translate3d(-60px, -110px, 0) scale(0.92);
    }
  }

  @keyframes floatOrb4 {
    0% {
      transform: translate3d(0px, 0px, 0) scale(1);
    }
    50% {
      transform: translate3d(-100px, -80px, 0) scale(1.15);
    }
    100% {
      transform: translate3d(80px, 60px, 0) scale(0.88);
    }
  }

  .sparkle {
    position: absolute;
    width: 3.5px;
    height: 3.5px;
    border-radius: 9999px;
    background: radial-gradient(circle, #ffffff 0%, rgba(165, 180, 252, 0.8) 60%, transparent 100%);
    box-shadow: 0 0 10px 1.5px rgba(147, 197, 253, 0.7);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .animate-sparkle-1 {
    animation: sparkleTwinkle 7s ease-in-out infinite alternate;
  }

  .animate-sparkle-2 {
    animation: sparkleTwinkle 9s ease-in-out 2s infinite alternate;
  }

  .animate-sparkle-3 {
    animation: sparkleTwinkle 8s ease-in-out 4s infinite alternate;
  }

  @keyframes sparkleTwinkle {
    0% {
      opacity: 0.15;
      transform: translate3d(0, 0, 0) scale(0.7);
    }
    50% {
      opacity: 0.85;
      transform: translate3d(10px, -15px, 0) scale(1.3);
    }
    100% {
      opacity: 0.2;
      transform: translate3d(-8px, -25px, 0) scale(0.8);
    }
  }
</style>
