---
// Ambient dynamic background with subtle glow orbs
---

<div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
  <!-- Subtle dark grid texture -->
  <div 
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: radial-gradient(rgba(255, 255, 255, 0.4) 1px, transparent 1px); background-size: 24px 24px;"
  ></div>

  <!-- Primary Cyan Glow Orb -->
  <div 
    class="absolute -top-[15%] left-1/2 -translate-x-1/2 w-[550px] h-[550px] bg-cyan-500/10 rounded-full blur-[120px] animate-aurora-1"
  ></div>

  <!-- Violet / Indigo Accent Glow Orb -->
  <div 
    class="absolute top-[35%] -left-[10%] w-[450px] h-[450px] bg-indigo-600/10 rounded-full blur-[130px] animate-aurora-2"
  ></div>

  <!-- Deep Pink / Purple Bottom Glow Orb -->
  <div 
    class="absolute bottom-[5%] -right-[10%] w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-[140px] animate-aurora-1"
  ></div>
</div>
