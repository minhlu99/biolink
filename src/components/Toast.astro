---
// Toast notification component for copy & share feedback
---

<div
  id="toast-notification"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-dark-900/90 text-white border border-cyan-500/30 shadow-2xl backdrop-blur-xl opacity-0 translate-y-4 pointer-events-none transition-all duration-300"
>
  <div class="w-5 h-5 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center flex-shrink-0">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
    </svg>
  </div>
  <span id="toast-message" class="text-xs sm:text-sm font-medium text-slate-200">
    Đã sao chép liên kết!
  </span>
</div>

<script>
  const shareBtn = document.getElementById('btn-share-bio');
  const toast = document.getElementById('toast-notification');
  const toastMsg = document.getElementById('toast-message');
  let timeoutId: number | undefined;

  function showToast(message: string) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = message;
    toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');

    if (timeoutId) window.clearTimeout(timeoutId);
    timeoutId = window.setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    }, 2800);
  }

  shareBtn?.addEventListener('click', async () => {
    const url = window.location.href;
    const title = document.title;

    if (navigator.share) {
      try {
        await navigator.share({
          title,
          text: `Khám phá các liên kết của tôi:`,
          url,
        });
      } catch (err) {
        // User cancelled share or failed, fallback to copy
        copyToClipboard(url);
      }
    } else {
      copyToClipboard(url);
    }
  });

  async function copyToClipboard(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      showToast('Đã sao chép liên kết vào bộ nhớ tạm!');
    } catch {
      showToast('Không thể sao chép, vui lòng sao chép thủ công.');
    }
  }
</script>
